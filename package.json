{
  "name": "nossa-casa",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:vps": "node scripts/build-vps.mjs",
    "test": "jest",
    "test:smoke": "jest __tests__/smoke.test.js",
    "referencias": "node scripts/recapturar-referencias.mjs docs/referencia && node scripts/folha-de-contacto.mjs docs/referencia docs/referencia/todos-os-ecras.png",
    "simular:saude": "node scripts/simular-exportacao-saude.mjs",
    "simular:casa": "node scripts/simular-casa.mjs",
    "aceitacao": "node db/pocketbase/aceitacao/correr.mjs",
    "db:provar": "node db/pocketbase/provar-tudo.mjs",
    "db:servir": "pocketbase serve --http=127.0.0.1:8095 --migrationsDir db/pocketbase/pb_migrations --hooksDir db/pocketbase/pb_hooks",
    "db:colecoes": "node db/pocketbase/criar-colecoes.mjs && node db/pocketbase/criar-credenciais-agenda.mjs",
    "db:campos": "node db/pocketbase/acrescentar-campos.mjs",
    "db:google": "node db/pocketbase/configurar-google.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/roboto": "^0.4.2",
    "@expo/metro-runtime": "~57.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.14",
    "expo-mail-composer": "~57.0.1",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "pocketbase": "^0.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "private": true,
  "devDependencies": {
    "jest-expo": "^57.0.4",
    "puppeteer-core": "^25.9.0"
  }
}
